<Project>
  <PropertyGroup>
    <PowerGuardPatch>24</PowerGuardPatch>
    <Version>0.1.$(PowerGuardPatch)</Version>
    <AssemblyVersion>0.1.$(PowerGuardPatch).0</AssemblyVersion>
    <FileVersion>0.1.$(PowerGuardPatch).0</FileVersion>
    <InformationalVersion>0.1.$([System.String]::Copy('$(PowerGuardPatch)').PadLeft(3, '0'))</InformationalVersion>
    <Product>PowerGuard</Product>
    <Authors>PowerGuard Contributors</Authors>
    <Company>PowerGuard</Company>
    <Copyright>Copyright (c) 2026</Copyright>
  </PropertyGroup>
</Project>
