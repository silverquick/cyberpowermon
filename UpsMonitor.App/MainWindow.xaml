<Window x:Class="UpsMonitor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:UpsMonitor.App"
        Title="{Binding WindowTitle}" Height="780" Width="1240" MinHeight="680" MinWidth="1040"
        Icon="Resources/app.png"
        Background="{DynamicResource WindowBrush}" FontFamily="Segoe UI Variable Text"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <local:EnergyPeriodFormatConverter x:Key="EnergyPeriodFormatConverter" />
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="22" />
            <Setter Property="Margin" Value="6" />
        </Style>
        <Style x:Key="MetricCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="MinHeight" Value="138" />
        </Style>
        <Style x:Key="CaptionStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="MetricValueStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
        <Style x:Key="PageTitleStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="InfoLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="Margin" Value="0,7" />
        </Style>
        <Style x:Key="InfoValueStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,7" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="NavItemStyle" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid Margin="10,3">
                            <Border x:Name="NavBackground" Background="Transparent" CornerRadius="8" Padding="14,11">
                                <ContentPresenter ContentSource="Header" />
                            </Border>
                            <Border x:Name="SelectionIndicator" Width="3" Height="18" CornerRadius="2"
                                    Background="#3B82F6" HorizontalAlignment="Left" Opacity="0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="NavBackground" Property="Background" Value="{DynamicResource SelectedNavBrush}" />
                                <Setter TargetName="SelectionIndicator" Property="Opacity" Value="1" />
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavBackground" Property="Background" Value="{DynamicResource SecondaryPanelBrush}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="NavBackground" Property="Background" Value="{DynamicResource SelectedNavBrush}" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MainNavigationStyle" TargetType="TabControl">
            <Setter Property="TabStripPlacement" Value="Left" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Background="{DynamicResource NavigationBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                                <DockPanel>
                                    <Border DockPanel.Dock="Bottom" Margin="16" Padding="12" CornerRadius="8" Background="{DynamicResource SecondaryPanelBrush}">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource MonitoringOnly}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}" />
                                            <TextBlock Text="{DynamicResource NoActionsV01}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,3,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                    <TabPanel IsItemsHost="True" Margin="0,12,0,0" />
                                </DockPanel>
                            </Border>
                            <Border Grid.Column="1" Background="Transparent">
                                <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TelemetryGridColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource NavigationBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PopupHoverBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PopupSelectedBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TelemetryGridCellStyle" TargetType="DataGridCell">
            <Setter Property="Padding" Value="7,5" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SelectedNavBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TelemetryGridRowStyle" TargetType="DataGridRow">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SelectedNavBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TelemetryGridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="EnableRowVirtualization" Value="True" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="RowBackground" Value="{DynamicResource PanelBrush}" />
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource SecondaryPanelBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource TelemetryGridColumnHeaderStyle}" />
            <Setter Property="CellStyle" Value="{StaticResource TelemetryGridCellStyle}" />
            <Setter Property="RowStyle" Value="{StaticResource TelemetryGridRowStyle}" />
        </Style>
        <Style x:Key="SubTabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TabPanel IsItemsHost="True" Background="Transparent" />
                            <Border Grid.Row="1" Background="Transparent" BorderThickness="0">
                                <ContentPresenter x:Name="PART_SelectedContentHost"
                                                  ContentSource="SelectedContent" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SubTabItemStyle" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="15,9" />
            <Setter Property="Margin" Value="0,0,5,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBackground"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBackground" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBackground" Property="Background" Value="{DynamicResource SelectedNavBrush}" />
                                <Setter TargetName="TabBackground" Property="BorderBrush" Value="#3B82F6" />
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="EventHeaderStyle" TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="{DynamicResource NavigationBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PopupHoverBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PopupSelectedBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="EventItemStyle" TargetType="ListViewItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Padding" Value="5,4" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SelectedNavBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource NavigationBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="22,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="9" Background="Transparent" ClipToBounds="True">
                        <Image Source="Resources/app.png" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <StackPanel Margin="12,0,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="PowerGuard" FontFamily="Segoe UI Variable Display" FontSize="19" FontWeight="SemiBold" />
                            <Border Background="{DynamicResource SecondaryPanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding AppVersion, StringFormat='v{0}'}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{DynamicResource AppSubtitle}" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding OpenMiniMonitorCommand}" Margin="0,0,16,0" Padding="10,5" Background="{DynamicResource SecondaryPanelBrush}" BorderBrush="{DynamicResource BorderBrush}" ToolTip="{DynamicResource OpenMiniMonitorHelp}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE740;" FontFamily="Segoe Fluent Icons" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource OpenMiniMonitor}" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Border Width="9" Height="9" CornerRadius="5" Background="{Binding StatusAccent}" Margin="0,0,9,0" />
                    <TextBlock Text="{Binding ConnectionText}" FontWeight="SemiBold" Margin="0,0,18,0" />
                    <TextBlock Text="{Binding LastUpdateText}" Foreground="{DynamicResource MutedTextBrush}" />
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" Style="{StaticResource MainNavigationStyle}" ItemContainerStyle="{StaticResource NavItemStyle}" SelectedIndex="{Binding SelectedNavigationIndex, Mode=TwoWay}">
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE80F;" FontFamily="Segoe Fluent Icons" FontSize="17" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" />
                        <TextBlock Text="{DynamicResource Dashboard}" Margin="13,0,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="28,25,28,34">
                        <TextBlock Text="{DynamicResource Dashboard}" Style="{StaticResource PageTitleStyle}" />
                        <TextBlock Text="{DynamicResource DashboardSubtitle}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,18" />

                        <Border Style="{StaticResource CardStyle}" BorderBrush="{Binding StatusAccent}" BorderThickness="1,1,1,1" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Width="44" Height="44" CornerRadius="22" Background="{Binding StatusAccent}">
                                    <TextBlock Text="&#xE930;" FontFamily="Segoe Fluent Icons" FontSize="19" Foreground="{DynamicResource AccentContentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                    <TextBlock Text="{Binding StatusMessage}" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding StateText}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding LastError}" Foreground="{DynamicResource DangerTextBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <UniformGrid Columns="4" Margin="-6,0,-6,14">
                            <Border Style="{StaticResource MetricCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource UpsStatus}" Style="{StaticResource CaptionStyle}" />
                                    <TextBlock Text="{Binding StateText}" Style="{StaticResource MetricValueStyle}" />
                                    <TextBlock Text="{Binding InputVoltageSummaryText}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,8,0,0" />
                                    <local:TimeSeriesChart Height="28" Margin="0,10,0,0" Data="{Binding VoltageHistory}" Compact="True" IsHitTestVisible="False" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource MetricCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Battery}" Style="{StaticResource CaptionStyle}" />
                                    <TextBlock Text="{Binding BatteryText}" Style="{StaticResource MetricValueStyle}" />
                                    <ProgressBar Value="{Binding BatteryProgress, Mode=OneWay}" Maximum="100" Height="5" Margin="0,13,0,0" Foreground="{Binding StatusAccent}" />
                                    <local:TimeSeriesChart Height="28" Margin="0,10,0,0" Data="{Binding BatteryChargeHistory}" FixedMinimum="0" FixedMaximum="100" Compact="True" IsHitTestVisible="False" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource MetricCardStyle}" BorderBrush="{Binding BatteryHealthAccent}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource BatteryHealth}" Style="{StaticResource CaptionStyle}" />
                                    <TextBlock Text="{Binding BatteryHealthText}" Style="{StaticResource MetricValueStyle}" />
                                    <TextBlock Text="{Binding BatteryHealthDetailText}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0" />
                                    <local:TimeSeriesChart Height="28" Margin="0,10,0,0" Data="{Binding HealthHistory}" FixedMinimum="0" FixedMaximum="100" Compact="True" IsHitTestVisible="False" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource MetricCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource EstimatedRuntime}" Style="{StaticResource CaptionStyle}" />
                                    <TextBlock Text="{Binding RuntimeText}" Style="{StaticResource MetricValueStyle}" />
                                    <TextBlock Text="{DynamicResource AtCurrentLoad}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,8,0,0" />
                                    <local:TimeSeriesChart Height="28" Margin="0,10,0,0" Data="{Binding RuntimeHistory}" Compact="True" IsHitTestVisible="False" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Grid Margin="-6,0,-6,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="1.5*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Power}" Style="{StaticResource SectionTitleStyle}" />
                                    <Grid Margin="0,13,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                            <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                            <RowDefinition /><RowDefinition />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="{DynamicResource InputVoltage}" Style="{StaticResource InfoLabelStyle}" /><TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding InputVoltageText}" Style="{StaticResource InfoValueStyle}" FontWeight="SemiBold" />
                                        <TextBlock Grid.Row="1" Text="{DynamicResource OutputVoltage}" Style="{StaticResource InfoLabelStyle}" /><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding OutputVoltageText}" Style="{StaticResource InfoValueStyle}" FontWeight="SemiBold" />
                                        <TextBlock Grid.Row="2" Text="{DynamicResource VoltageMargin}" Style="{StaticResource InfoLabelStyle}" /><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding VoltageMarginText}" Style="{StaticResource InfoValueStyle}" Foreground="{DynamicResource MutedTextBrush}" />
                                        <TextBlock Grid.Row="3" Text="{DynamicResource AvrBoost}" Style="{StaticResource InfoLabelStyle}" /><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding AvrBoostText}" Style="{StaticResource InfoValueStyle}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" />
                                        <TextBlock Grid.Row="4" Text="{DynamicResource BatteryVoltage}" Style="{StaticResource InfoLabelStyle}" /><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding BatteryVoltageText}" Style="{StaticResource InfoValueStyle}" FontWeight="SemiBold" />
                                        <TextBlock Grid.Row="5" Text="{DynamicResource CellVoltage}" Style="{StaticResource InfoLabelStyle}" /><TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding CellVoltageText}" Style="{StaticResource InfoValueStyle}" Foreground="{DynamicResource MutedTextBrush}" />
                                        <TextBlock Grid.Row="6" Text="{DynamicResource Load}" Style="{StaticResource InfoLabelStyle}" /><TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding PercentLoadText}" Style="{StaticResource InfoValueStyle}" FontWeight="SemiBold" />
                                        <TextBlock Grid.Row="7" Text="{DynamicResource ActivePower}" Style="{StaticResource InfoLabelStyle}" /><TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding ActivePowerText}" Style="{StaticResource InfoValueStyle}" FontWeight="SemiBold" />
                                        <TextBlock Grid.Row="8" Text="{DynamicResource PowerMargin}" Style="{StaticResource InfoLabelStyle}" /><TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding PowerMarginText}" Style="{StaticResource InfoValueStyle}" Foreground="{DynamicResource SuccessTextBrush}" FontWeight="SemiBold" />
                                        <TextBlock Grid.Row="9" Text="{DynamicResource ApparentPower}" Style="{StaticResource InfoLabelStyle}" /><TextBlock Grid.Row="9" Grid.Column="1" Text="{Binding ApparentPowerText}" Style="{StaticResource InfoValueStyle}" FontWeight="SemiBold" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource ShutdownAutomation}" Style="{StaticResource SectionTitleStyle}" />
                                    <Grid Margin="0,13,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="{DynamicResource AudibleAlarm}" Style="{StaticResource InfoLabelStyle}" /><TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding AudibleAlarmText}" Style="{StaticResource InfoValueStyle}" />
                                        <TextBlock Grid.Row="1" Text="{DynamicResource SelfTest}" Style="{StaticResource InfoLabelStyle}" /><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelfTestText}" Style="{StaticResource InfoValueStyle}" />
                                        <TextBlock Grid.Row="2" Text="{DynamicResource LowVoltageTransferThreshold}" Style="{StaticResource InfoLabelStyle}" /><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding TransferRangeText}" Style="{StaticResource InfoValueStyle}" />
                                        <TextBlock Grid.Row="3" Text="{DynamicResource RatedPower}" Style="{StaticResource InfoLabelStyle}" /><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding RatedPowerText}" Style="{StaticResource InfoValueStyle}" />
                                    </Grid>
                                    <Border Background="{DynamicResource SecondaryPanelBrush}" CornerRadius="8" Padding="14" Margin="0,14,0,12">
                                        <StackPanel Orientation="Horizontal"><Border Width="8" Height="8" CornerRadius="4" Background="#64748B" Margin="0,0,9,0" /><TextBlock Text="{DynamicResource NotArmed}" FontWeight="SemiBold" /></StackPanel>
                                    </Border>
                                    <TextBlock Text="{DynamicResource ActionsDisabled}" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" LineHeight="20" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource CardStyle}" BorderBrush="{Binding BatteryHealthAccent}" Margin="0,14,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="1.8*" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource BatteryHealthAnalysis}" Style="{StaticResource SectionTitleStyle}" />
                                    <TextBlock Text="{DynamicResource BatteryHealthAnalysisSubtitle}" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,5,24,16" />
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="10" Height="10" CornerRadius="5" Background="{Binding BatteryHealthAccent}" Margin="0,5,10,0" VerticalAlignment="Top" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding BatteryHealthText}" FontFamily="Segoe UI Variable Display" FontSize="32" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding BatteryHealthDetailText}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </StackPanel>
                                    <Grid Margin="0,18,24,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                        <TextBlock Text="{DynamicResource HealthConfidenceLabel}" Style="{StaticResource InfoLabelStyle}" />
                                        <TextBlock Grid.Column="1" Text="{Binding BatteryHealthConfidenceText}" Style="{StaticResource InfoValueStyle}" Margin="18,7,0,7" />
                                        <TextBlock Grid.Row="1" Text="{DynamicResource HealthMethodLabel}" Style="{StaticResource InfoLabelStyle}" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding BatteryHealthMethodText}" Style="{StaticResource InfoValueStyle}" Margin="18,7,0,7" />
                                        <TextBlock Grid.Row="2" Text="{DynamicResource HealthRelativeTrendLabel}" Style="{StaticResource InfoLabelStyle}" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding BatteryRelativeTrendText}" Style="{StaticResource InfoValueStyle}" Margin="18,7,0,7" />
                                        <TextBlock Grid.Row="3" Text="{DynamicResource HealthAnchorLabel}" Style="{StaticResource InfoLabelStyle}" />
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding BatteryHealthAnchorText}" Style="{StaticResource InfoValueStyle}" Margin="18,7,0,7" TextWrapping="Wrap" />
                                        <TextBlock Grid.Row="4" Text="{DynamicResource HealthDataQuality}" Style="{StaticResource InfoLabelStyle}" />
                                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding BatteryHealthDataQualityText}" Style="{StaticResource InfoValueStyle}" Margin="18,7,0,7" />
                                        <TextBlock Grid.Row="5" Text="{DynamicResource ReplacementAssessmentLabel}" Style="{StaticResource InfoLabelStyle}" />
