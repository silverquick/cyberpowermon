                        </Border>
                        <Border Style="{StaticResource CardStyle}" MaxWidth="720" HorizontalAlignment="Left">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Storage}" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="Version" Style="{StaticResource CaptionStyle}" Margin="0,14,0,0" />
                                <TextBlock Text="{Binding AppVersion, StringFormat='v{0}'}" FontFamily="Cascadia Mono" FontSize="11" Margin="0,5,0,12" />
                                <TextBlock Text="{DynamicResource Configuration}" Style="{StaticResource CaptionStyle}" />
                                <TextBlock Text="{Binding ConfigurationFile}" FontFamily="Cascadia Mono" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,12" />
                                <TextBlock Text="{DynamicResource Logs}" Style="{StaticResource CaptionStyle}" />
                                <TextBlock Text="{Binding LogsDirectory}" FontFamily="Cascadia Mono" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
